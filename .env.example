# AgentMesh Environment Configuration
# Copy this file to .env and customize values for your environment.

# Application
APP_NAME=AgentMesh
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# PostgreSQL (Async SQLAlchemy)
# For local SQLite fallback during development without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./agentmesh_dev.db
DATABASE_URL=postgresql+asyncpg://agentmesh:agentmesh@localhost:5432/agentmesh
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false
DB_CONNECT_TIMEOUT=5.0

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=3.0
REDIS_CONNECT_TIMEOUT=3.0

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agentmesh-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

# Security & Registry
ALLOW_PRIVATE_AGENT_ENDPOINTS=false
AGENT_HEALTH_CHECK_TIMEOUT=3.0
AGENT_REGISTRY_CACHE_TTL=60
JWT_SECRET_KEY=change-me-in-production-use-strong-random-secret
JWT_ALGORITHM=HS256

# LLM Providers
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=30.0
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

